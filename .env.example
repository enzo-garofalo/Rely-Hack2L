# Postgres
POSTGRES_DB=opero
POSTGRES_USER=opero
POSTGRES_PASSWORD=opero
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# ERP simulado (via HTTP, apps/erp_simulator)
ERP_API_KEY=dev-erp-api-key
ERP_BASE_URL=http://backend:8000/api/erp

# ElevenLabs (voz - enhancement, backend only, apps/core/voice.py)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TIMEOUT_SECONDS=20

# Fallback de voz pra demo (RNF09) - texto fixo usado por
# generate_voice_fallback pra gerar backend/apps/core/fixtures/voice_fallback/
VOICE_FALLBACK_TEXT=Dez caixas de coca dois litros, seis fardos da zero, e quinze do óleo da última vez.

# WhatsApp real (E10 - enhancement, whatsapp-gateway/ + apps/core/whatsapp.py)
# Token compartilhado gateway <-> Django: protege POST /send (Django ->
# gateway) e POST /api/whatsapp/inbound/ (gateway -> Django). Sem ele o
# canal real fica DESLIGADO (o Django nao chama o gateway e o inbound
# recusa tudo). Nunca vai pro frontend.
WHATSAPP_GATEWAY_TOKEN=dev-whatsapp-gateway-token
# Django -> gateway (nome do servico na rede do compose)
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=10
# gateway -> Django
OPERO_API_URL=http://backend:8000/api
# Porta publicada do gateway no host (health/debug)
WHATSAPP_GATEWAY_PORT=3001
